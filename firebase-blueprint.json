{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil de l'étudiant ou administrateur connecté via Firebase Auth",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID de l'utilisateur",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Adresse email de l'étudiant",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Nom complet de l'étudiant",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "URL de la photo de profil Google",
          "maxLength": 512
        },
        "matricule": {
          "type": "string",
          "description": "Matricule étudiant UPGC",
          "maxLength": 40
        },
        "filiere": {
          "type": "string",
          "description": "Filière universitaire à l'UPGC",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Rôle de l'utilisateur",
          "enum": ["student", "admin"]
        },
        "isVerified": {
          "type": "boolean",
          "description": "Indique si le profil est vérifié"
        },
        "createdAt": {
          "type": "string",
          "description": "Date de création du compte"
        },
        "updatedAt": {
          "type": "string",
          "description": "Date de dernière mise à jour"
        }
      },
      "required": ["uid", "email", "displayName"]
    },
    "UserTicket": {
      "title": "UserTicket",
      "description": "Ticket repas numérique CROU-K lié au compte étudiant",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique du ticket",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "UID de l'étudiant propriétaire",
          "maxLength": 128
        },
        "reference": {
          "type": "string",
          "description": "Référence de paiement Jèko / CinetPay",
          "maxLength": 64
        },
        "service": {
          "type": "string",
          "description": "Service du repas (Déjeuner / Dîner)",
          "maxLength": 32
        },
        "price": {
          "type": "number",
          "description": "Prix du ticket en F CFA"
        },
        "date": {
          "type": "string",
          "description": "Date de validité",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "description": "Statut du ticket",
          "enum": ["VALID", "USED", "EXPIRED"]
        },
        "qrCode": {
          "type": "string",
          "description": "Chaîne du code QR",
          "maxLength": 256
        },
        "usedAt": {
          "type": "string",
          "description": "Date et heure de validation au réfectoire",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "Date d'achat"
        }
      },
      "required": ["id", "userId", "service", "price", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profils des utilisateurs et étudiants UPGC"
    },
    "/users/{userId}/tickets/{ticketId}": {
      "schema": "UserTicket",
      "description": "Tickets repas personnels de l'étudiant"
    }
  }
}
