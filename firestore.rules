rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'metroone110@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 120 &&
             (!('matricule' in data) || (data.matricule is string && data.matricule.size() <= 40)) &&
             (!('filiere' in data) || (data.filiere is string && data.filiere.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['id', 'userId', 'service', 'price', 'status']) &&
             data.id is string && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.service is string && data.service.size() <= 32 &&
             data.price is number && data.price > 0 &&
             data.status in ['VALID', 'USED', 'EXPIRED'];
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUserProfile(request.resource.data);
      allow delete: if isAdmin();

      // User tickets subcollection
      match /tickets/{ticketId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidTicket(request.resource.data);
        allow update: if (isOwner(userId) || isAdmin()) && isValidTicket(request.resource.data);
        allow delete: if isAdmin();
      }
    }
  }
}
